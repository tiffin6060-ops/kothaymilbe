# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit it.

# Generate on the machine that uses it, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# True only on your own PC. Must be False on the server.
DEBUG=False

# Comma-separated, no spaces.
ALLOWED_HOSTS=api.kothaymilbe.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://api.kothaymilbe.com

# sqlite (local PC) or postgres (server)
DB_ENGINE=postgres

# Used only when DB_ENGINE=postgres. Empty DB_HOST and DB_PASSWORD = peer auth over the Unix socket.
DB_NAME=kothaymilbe
DB_USER=kothaymilbe
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Folder for the order rate-limit counters (shared by all Gunicorn workers). Absolute path on
# the server; if empty or missing, backend/.cache is used.
CACHE_DIR=/home/kothaymilbe/kothaymilbe/backend/.cache
